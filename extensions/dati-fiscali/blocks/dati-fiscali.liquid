{%- comment -%}
  Dati Fiscali B2B — app embed block.

  Iniettato in theme.liquid, quindi indipendente dal template: funziona sulla pagina
  carrello e sul cart drawer senza toccare il codice del tema.
{%- endcomment -%}

{{ 'dati-fiscali.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  I selettori delle uscite verso il check-out stanno qui e non nel JavaScript
  perche' li leggono in due: lo scudo di partenza qui sotto e il gate vero in
  dati-fiscali.js. Una lista sola, cosi' non possono divergere.
{%- endcomment -%}
{%- assign selettori_checkout = '[name="checkout"], a[href$="/checkout"], a[href*="/checkout?"], a[href*="/cart/checkout"], [data-checkout-trigger], #checkout' -%}

<script id="dati-fiscali-config" type="application/json">
  {
    "urlValidatori": {{ 'validatori.js' | asset_url | json }},
    "selettoriCheckout": {{ selettori_checkout | json }},
    "modalitaColore": {{ block.settings.modalita_colore | json }},
    "colorePrimario": {{ block.settings.colore_primario | json }},
    "coloreTestoPrimario": {{ block.settings.colore_testo_primario | json }},
    "raggioBordi": {{ block.settings.raggio_bordi | json }},
    "apriSuCarrello": {{ block.settings.apri_su_carrello | json }},
    "nascondiPagamentiRapidi": {{ block.settings.nascondi_pagamenti_rapidi | json }},
    "ammettiPa": {{ block.settings.ammetti_pa | json }},
    "selettoriExtra": {{ block.settings.selettori_extra | default: '' | json }},
    "log": {{ block.settings.log_console | json }},
    "radiceNegozio": {{ routes.root_url | json }}
  }
</script>

{%- comment -%}
  Scudo di partenza, e il motivo per cui non e' un modulo.

  Il modulo in fondo al blocco viene eseguito solo dopo il parsing e dopo che la
  CDN ha consegnato dati-fiscali.js: fra il momento in cui il bottone "Vai al
  pagamento" diventa cliccabile e quello in cui il gate esiste passano da poche
  decine di millisecondi a diversi secondi su una rete lenta. Un clic in quella
  finestra arriva al check-out senza dati fiscali, ed e' successo davvero nelle
  prove. Questo script e' classico e inline, quindi gira durante il parsing:
  trattiene i clic finche' il gate vero non e' pronto.

  Si toglie di mezzo da solo dopo dieci secondi: se il modulo non arriva, un
  negozio che non incassa e' un danno peggiore di una fattura senza codice SDI.
{%- endcomment -%}
<script>
  (function () {
    try {
      var config = JSON.parse(document.getElementById('dati-fiscali-config').textContent);
      var selettori = [config.selettoriCheckout, config.selettoriExtra]
        .filter(function (s) { return s; })
        .join(', ');
      if (!selettori) return;

      var scudo = { attivo: true, inSospeso: false };
      window.__datiFiscaliScudo = scudo;

      function trattieni(evento) {
        evento.preventDefault();
        evento.stopPropagation();
        evento.stopImmediatePropagation();
        scudo.inSospeso = true;
      }

      function alClick(evento) {
        if (!scudo.attivo) return;
        var bersaglio =
          evento.target && evento.target.closest ? evento.target.closest(selettori) : null;
        if (bersaglio) trattieni(evento);
      }

      function alSubmit(evento) {
        if (!scudo.attivo) return;
        var modulo = evento.target;
        if (!modulo || !modulo.matches || !modulo.matches('form[action*="/cart"]')) return;
        // Senza submitter non sappiamo se e' un aggiornamento quantita': si lascia passare.
        if (!evento.submitter || evento.submitter.name !== 'checkout') return;
        trattieni(evento);
      }

      document.addEventListener('click', alClick, true);
      document.addEventListener('submit', alSubmit, true);

      /** true se c'era un tentativo di check-out da riprendere. */
      scudo.rilascia = function () {
        if (!scudo.attivo) return false;
        scudo.attivo = false;
        document.removeEventListener('click', alClick, true);
        document.removeEventListener('submit', alSubmit, true);
        var inSospeso = scudo.inSospeso;
        scudo.inSospeso = false;
        return inSospeso;
      };

      window.setTimeout(function () {
        // Se il modulo e' arrivato ha gia' rilasciato: qui non resta nulla da fare.
        if (!scudo.rilascia()) return;
        var radice = String(config.radiceNegozio || '/').replace(/\/+$/, '');
        window.location.href = radice + '/checkout';
      }, 10000);
    } catch (errore) {
      /* Nessuno scudo e' meglio di un negozio rotto. */
    }
  })();
</script>

{% render 'modale-dati-fiscali', block: block %}

<script type="module">
  import { avvia } from {{ 'dati-fiscali.js' | asset_url | json }};
  avvia();
</script>

{%- comment -%}
  Shopify ammette al massimo 6 settings "non interattivi" (header e paragraph)
  per blocco: superarli fa fallire `shopify app deploy` con
  "settings: must have a maximum of 6 for non-interactive settings".
  Adesso siamo esattamente a 6: per aggiungere un header serve toglierne un altro.
{%- endcomment -%}
{% schema %}
{
  "name": "Dati fiscali B2B",
  "target": "body",
  "settings": [
    {
      "type": "paragraph",
      "content": "Raccolta obbligatoria dei dati per la fattura elettronica prima del check-out: tipo di cliente, ragione sociale, partita IVA, codice fiscale per le ditte individuali, codice SDI o PEC. Con validazione reale di partita IVA e codice fiscale."
    },
    {
      "type": "header",
      "content": "Aspetto"
    },
    {
      "type": "select",
      "id": "modalita_colore",
      "label": "Colori del modale",
      "info": "In automatico il modale copia i colori del bottone di check-out del tema.",
      "options": [
        { "value": "auto", "label": "Automatico dal tema" },
        { "value": "manuale", "label": "Scelti qui sotto" }
      ],
      "default": "auto"
    },
    {
      "type": "color",
      "id": "colore_primario",
      "label": "Colore primario",
      "info": "Usato se la modalità è manuale, o come ripiego se il tema non è leggibile.",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "colore_testo_primario",
      "label": "Colore del testo sul primario",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "raggio_bordi",
      "label": "Raggio dei bordi",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Testi"
    },
    {
      "type": "text",
      "id": "titolo",
      "label": "Titolo del modale",
      "default": "Dati per la fattura elettronica"
    },
    {
      "type": "textarea",
      "id": "descrizione",
      "label": "Testo introduttivo",
      "info": "Facoltativo, e vuoto di proposito: il titolo dice già perché siamo qui, e ogni riga in più allontana il primo campo. Da usare solo per qualcosa che il modale non dice altrove."
    },
    {
      "type": "text",
      "id": "testo_bottone",
      "label": "Testo del bottone di conferma",
      "default": "Salva e vai al pagamento"
    },
    {
      "type": "header",
      "content": "Comportamento"
    },
    {
      "type": "checkbox",
      "id": "apri_su_carrello",
      "label": "Apri il modale all'arrivo sulla pagina carrello",
      "info": "Raccoglie i dati prima ancora che il cliente pensi al check-out.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "nascondi_pagamenti_rapidi",
      "label": "Nascondi i pagamenti rapidi finché i dati mancano",
      "info": "Shop Pay, PayPal, Google Pay e Apple Pay saltano la pagina carrello e quindi il modale.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "ammetti_pa",
      "label": "Accetta i codici destinatario a 6 caratteri (Pubblica Amministrazione)",
      "default": false
    },
    {
      "type": "text",
      "id": "selettori_extra",
      "label": "Selettori CSS aggiuntivi per i bottoni di check-out",
      "info": "Separati da virgola. Serve solo se il tema usa bottoni non standard."
    },
    {
      "type": "checkbox",
      "id": "log_console",
      "label": "Log di diagnostica in console",
      "default": false
    },
    {
      "type": "header",
      "content": "Imagine Software"
    },
    {
      "type": "paragraph",
      "content": "App sviluppata su misura da Imagine Software — imaginesoftware.it · Assistenza: info@imaginesoftware.it"
    },
    {
      "type": "checkbox",
      "id": "mostra_credito",
      "label": "Mostra la firma nel modale",
      "info": "Aggiunge una riga discreta \"a cura di Imagine Software\" in fondo al modale. Visibile ai clienti del negozio: [imaginesoftware.it](https://imaginesoftware.it)",
      "default": false
    }
  ]
}
{% endschema %}
